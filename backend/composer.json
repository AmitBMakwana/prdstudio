{
    "name": "aiprd/backend",
    "type": "project",
    "description": "AI PRD Studio Laravel API Backend for MySQL Database aiprd",
    "keywords": ["laravel", "framework", "aiprd", "prd-generator"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "*",
        "laravel/sanctum": "*",
        "laravel/tinker": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
